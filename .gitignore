# Fixtures are generated by scripts/run-tests.ps1, not committed. The hostile
# set derives from the Latin sample, which carries a creation date, so leaving
# them tracked meant every test run produced a binary diff in four files.
tests/fixtures/*.pdf
tests/fixtures/hostile/

work/
